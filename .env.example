NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — bypasses RLS. Used by confirmPayment() (src/lib/paystack.ts)
# to mark orders paid and clear carts from contexts with no customer
# session at all (the Paystack webhook). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Used only by scripts/check-brand-guardrails-dynamic.mjs (postbuild) to
# load /admin with a real staff session. See that file's header comment.
GUARDRAIL_STAFF_EMAIL=
GUARDRAIL_STAFF_PASSWORD=

# Paystack test-mode secret key. Server-only — never prefix NEXT_PUBLIC_,
# never send to the client. Used to initialize/verify transactions and to
# verify webhook signatures (src/lib/paystack.ts).
PAYSTACK_SECRET_KEY=
